# UV 환경변수 설정 예시
# SSL 검증을 비활성화하려면 아래 주석을 해제하고 호스트를 지정하세요

# PyPI SSL 검증 비활성화 (권장하지 않음, 보안 위험)
# UV_INSECURE_HOST=pypi.org,files.pythonhosted.org

# 특정 호스트에 대해서만 SSL 검증 비활성화
# UV_INSECURE_HOST=your-company-mirror.com

# Native TLS 사용 (플랫폼의 인증서 스토어 사용)
# UV_NATIVE_TLS=true

# 프록시 설정 (필요한 경우)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
